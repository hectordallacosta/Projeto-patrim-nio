PORT=5000
NODE_ENV=development

# String de conexão MongoDB (ex: mongodb://127.0.0.1:27017/patrimonio_ti)
MONGODB_URI=mongodb://127.0.0.1:27017/patrimonio_ti

# Gere um segredo longo e aleatório (ex: openssl rand -hex 64)
JWT_SECRET=substitua_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h

# URL do servidor LDAP/AD (ldaps para SSL, ldap para sem SSL)
LDAP_URL=ldaps://seu-ad-server:636

# DN base para buscas no AD
LDAP_BASE_DN=OU=Usuarios,DC=empresa,DC=com,DC=br

# Conta de serviço com permissão de leitura no AD
LDAP_BIND_DN=CN=ServiceAccount,CN=Users,DC=empresa,DC=com,DC=br
LDAP_BIND_PASSWORD=senha_da_conta_de_servico

# OU onde os usuários serão buscados
LDAP_USER_SEARCH_BASE=OU=Usuarios,DC=empresa,DC=com,DC=br

# Domínio do AD (usado para montar o UPN: usuario@empresa.com.br)
LDAP_DOMAIN=empresa.com.br

# Senha do admin local (seed-admin.js). Padrão: Admin@1234
# ADMIN_PASSWORD=SuaSenhaForte@123
